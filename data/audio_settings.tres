[resource]
script = ExtResource("1_audio_settings")
; Title screen: plays once before Play, then the stems take over.
intro_track = ExtResource("10_intro_track")
intro_gain_db = -12.0
; Stems: every one plays from the start and loops in sync (shared loop point).
; The drums alternate each loop; the arp takes turn on with hostiles.
drums = [ExtResource("3_drums0"), ExtResource("4_drums1")]
arp_half = [ExtResource("5_arp_half1"), ExtResource("6_arp_half2")]
arp_full = [ExtResource("7_arp_full1"), ExtResource("8_arp_full2")]
drums_gain_db = 0.0
arp_gain_db = -4.0
; Half arp with 1-5 hostiles, full from 6 on.
arp_full_hostiles = 6
music_gain_db = 7.0
; Global effects level: every effect event gets this on top of its own gain.
effects_gain_db = 2.0
; The cyclone wind fades in when a cyclone enters the screen and out when it leaves.
cyclone_wind_fade_seconds = 1.0
; Played once when the run is lost (the loop above stops first).
outro_track = ExtResource("9_outro_track")
outro_gain_db = -9.0
; One entry per event, keyed by its event name.
events = Dictionary[StringName, ExtResource("2_audio_event")]({
&"placement": SubResource("AudioEvent_placement"),
&"placement_nest": SubResource("AudioEvent_placement_nest"),
&"placement_algae": SubResource("AudioEvent_placement_algae"),
&"predator_ate": SubResource("AudioEvent_predator_ate"),
&"item_hover": SubResource("AudioEvent_item_hover"),
&"item_available": SubResource("AudioEvent_item_available"),
&"cyclone_wind": SubResource("AudioEvent_cyclone_wind"),
&"cyclone_hit": SubResource("AudioEvent_cyclone_hit"),
&"co2_gone": SubResource("AudioEvent_co2_gone"),
&"bag_destroyed": SubResource("AudioEvent_bag_destroyed"),
&"ui_click": SubResource("AudioEvent_ui_click"),
&"ui_cancel": SubResource("AudioEvent_ui_cancel"),
&"ui_denied": SubResource("AudioEvent_ui_denied"),
&"fish_select": SubResource("AudioEvent_fish_select"),
&"fish_order": SubResource("AudioEvent_fish_order"),
&"fish_eat": SubResource("AudioEvent_fish_eat"),
&"turtle_eat": SubResource("AudioEvent_turtle_eat"),
&"eggs_laid": SubResource("AudioEvent_eggs_laid"),
&"eggs_hatched": SubResource("AudioEvent_eggs_hatched"),
&"eggs_died": SubResource("AudioEvent_eggs_died"),
&"fish_matured": SubResource("AudioEvent_fish_matured"),
&"fish_died": SubResource("AudioEvent_fish_died"),
&"coral_hit": SubResource("AudioEvent_coral_hit"),
&"coral_destroyed": SubResource("AudioEvent_coral_destroyed"),
&"algae_spread": SubResource("AudioEvent_algae_spread"),
&"predator_arrive": SubResource("AudioEvent_predator_arrive"),
&"predator_leave": SubResource("AudioEvent_predator_leave"),
&"bag_arrive": SubResource("AudioEvent_bag_arrive"),
&"co2_arrive": SubResource("AudioEvent_co2_arrive"),
&"threat_impact": SubResource("AudioEvent_threat_impact"),
&"turtle_arrive": SubResource("AudioEvent_turtle_arrive"),
&"turtle_ram": SubResource("AudioEvent_turtle_ram"),
&"collapse_warning": SubResource("AudioEvent_collapse_warning"),
&"collapse_cancelled": SubResource("AudioEvent_collapse_cancelled")
})
