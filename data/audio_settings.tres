[gd_resource type="Resource" script_class="AudioSettings" format=3]

; Audio tuning for the whole game (see docs/audio.md).
; Every value here overrides the defaults in data/audio_settings.gd.
; Levels are in dB: 0.0 is unmodified, negative is quieter, positive louder.
; Each AudioEvent_<name> sub-resource below is the audio of that event, and its
; name matches the event keys in core/audio_events.gd AudioEvents.TAKES.
; Music tracks available in assets/audio: game_loop/ (stems), outro.wav (one-shot).

[ext_resource type="Script" path="res://data/audio_settings.gd" id="1_audio_settings"]
[ext_resource type="Script" path="res://data/audio_event.gd" id="2_audio_event"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/drums0.wav" id="3_drums0"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/drums1.wav" id="4_drums1"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/arp_half1.wav" id="5_arp_half1"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/arp_half2.wav" id="6_arp_half2"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/arp_full1.wav" id="7_arp_full1"]
[ext_resource type="AudioStream" path="res://assets/audio/game_loop/arp_full2.wav" id="8_arp_full2"]
[ext_resource type="AudioStream" path="res://assets/audio/outro.wav" id="9_outro_track"]

; Placing an item that has no sound of its own (assets/audio/corallo).
; Slightly high-passed.
[sub_resource type="Resource" id="AudioEvent_placement"]
script = ExtResource("2_audio_event")
gain_db = -12.0
high_pass_hz = 400.0

; Placing a nest (assets/audio/nido).
[sub_resource type="Resource" id="AudioEvent_placement_nest"]
script = ExtResource("2_audio_event")
gain_db = -12.0

; Placing an algae (assets/audio/alga). Its take is much quieter than the
; others (peak -26 dBFS), so it gets a big boost to sit at the same level.
[sub_resource type="Resource" id="AudioEvent_placement_algae"]
script = ExtResource("2_audio_event")
gain_db = 4.0

; A predator eats a fish or a nest's eggs (assets/audio/eat).
[sub_resource type="Resource" id="AudioEvent_predator_ate"]
script = ExtResource("2_audio_event")
gain_db = -12.0

; Clicking an inventory item to place it, and a slot refilling (assets/audio/item).
[sub_resource type="Resource" id="AudioEvent_item_hover"]
script = ExtResource("2_audio_event")
gain_db = -8.0
high_pass_hz = 400.0

; An inventory slot refills (assets/audio/item).
[sub_resource type="Resource" id="AudioEvent_item_available"]
script = ExtResource("2_audio_event")
gain_db = -12.0

; A cyclone on screen (loops while it is visible) and its impact, very quiet.
[sub_resource type="Resource" id="AudioEvent_cyclone_wind"]
script = ExtResource("2_audio_event")
gain_db = -8.0

[sub_resource type="Resource" id="AudioEvent_cyclone_hit"]
script = ExtResource("2_audio_event")
gain_db = -16.0

; A CO2 cloud disappears (assets/audio/co2).
[sub_resource type="Resource" id="AudioEvent_co2_gone"]
script = ExtResource("2_audio_event")
gain_db = -12.0

; A plastic bag pops (assets/audio/busta).
[sub_resource type="Resource" id="AudioEvent_bag_destroyed"]
script = ExtResource("2_audio_event")

[resource]
script = ExtResource("1_audio_settings")
; Stems: every one plays from the start and loops in sync (shared loop point).
; The drums alternate each loop; the arp takes turn on with hostiles.
drums = [ExtResource("3_drums0"), ExtResource("4_drums1")]
arp_half = [ExtResource("5_arp_half1"), ExtResource("6_arp_half2")]
arp_full = [ExtResource("7_arp_full1"), ExtResource("8_arp_full2")]
drums_gain_db = 0.0
arp_gain_db = -4.0
; Half arp with 1-5 hostiles, full from 6 on.
arp_full_hostiles = 6
music_gain_db = 3.0
; The cyclone wind fades in when a cyclone enters the screen and out when it leaves.
cyclone_wind_fade_seconds = 1.0
; Played once when the run is lost (the loop above stops first).
outro_track = ExtResource("9_outro_track")
outro_gain_db = -6.0
; One entry per event, keyed by its event name.
events = Dictionary[StringName, ExtResource("2_audio_event")]({
&"placement": SubResource("AudioEvent_placement"),
&"placement_nest": SubResource("AudioEvent_placement_nest"),
&"placement_algae": SubResource("AudioEvent_placement_algae"),
&"predator_ate": SubResource("AudioEvent_predator_ate"),
&"item_hover": SubResource("AudioEvent_item_hover"),
&"item_available": SubResource("AudioEvent_item_available"),
&"cyclone_wind": SubResource("AudioEvent_cyclone_wind"),
&"cyclone_hit": SubResource("AudioEvent_cyclone_hit"),
&"co2_gone": SubResource("AudioEvent_co2_gone"),
&"bag_destroyed": SubResource("AudioEvent_bag_destroyed")
})
